@@ -0,0 +1,116 @@
+package com.coderstory.flyme10.xposedcompat;
+
+import java.lang.reflect.Member;
+
+import io.github.libxposed.api.XposedInterface;
+
+/**
+ * Legacy-shaped method hook callback, re-implemented on top of the modern libxposed API
+ * (io.github.libxposed:api). See {@link HookerImpl} for the bridging logic.
+ */
+public class XC_MethodHook {
+
+    public XC_MethodHook() {
+    }
+
+    /**
+     * @param priority kept for source compatibility with the legacy API, ignored by the
+     *                 modern API (all hooks use the default priority).
+     */
+    public XC_MethodHook(int priority) {
+    }
+
+    protected void beforeHookedMethod(MethodHookParam param) throws Throwable {
+    }
+
+    protected void afterHookedMethod(MethodHookParam param) throws Throwable {
+    }
+
+    public static final class MethodHookParam {
+
+        /** The hooked method/constructor. */
+        public Member method;
+
+        /** The {@code this} reference for an instance method, or {@code null} for static methods. */
+        public Object thisObject;
+
+        /** Arguments to the method call. */
+        public Object[] args;
+
+        private Object result = null;
+        private Throwable throwable = null;
+        boolean returnEarly = false;
+
+        /** Returns the result of the method call. */
+        public Object getResult() {
+            return result;
+        }
+
+        /**
+         * Modify the result of the method call.
+         * <p>If called from {@link #beforeHookedMethod}, it prevents the call to the original method.
+         */
+        public void setResult(Object result) {
+            this.result = result;
+            this.throwable = null;
+            this.returnEarly = true;
+        }
+
+        /** Returns the {@link Throwable} thrown by the method, or {@code null}. */
+        public Throwable getThrowable() {
+            return throwable;
+        }
+
+        /** Returns true if an exception was thrown by the method. */
+        public boolean hasThrowable() {
+            return throwable != null;
+        }
+
+        /**
+         * Modify the exception thrown of the method call.
+         * <p>If called from {@link #beforeHookedMethod}, it prevents the call to the original method.
+         */
+        public void setThrowable(Throwable throwable) {
+            this.throwable = throwable;
+            this.result = null;
+            this.returnEarly = true;
+        }
+
+        /** Returns the result of the method call, or throws the Throwable caused by it. */
+        public Object getResultOrThrowable() throws Throwable {
+            if (throwable != null) {
+                throw throwable;
+            }
+            return result;
+        }
+    }
+
+    /** An object with which the method/constructor can be unhooked. */
+    public class Unhook {
+
+        private final XposedInterface.HookHandle handle;
+
+        Unhook(XposedInterface.HookHandle handle) {
+            this.handle = handle;
+        }
+
+        /** Returns the method/constructor that has been hooked. */
+        public Member getHookedMethod() {
+            return handle == null ? null : handle.getExecutable();
+        }
+
+        public void unhook() {
+            if (handle != null) {
+                handle.unhook();
+            }
+        }
+
+        public XC_MethodHook getCallback() {
+            return XC_MethodHook.this;
+        }
+    }
+
+    Unhook newUnhook(XposedInterface.HookHandle handle) {
+        return new Unhook(handle);
+    }
+}
diff --git a/app/src/main/java/com/coderstory/flyme10/xposedcompat/XC_MethodReplacement.java b/app/src/main/java/com/coderstory/flyme10/xposedcompat/XC_MethodReplacement.java
new file mode 100644
index 0000000..a37c9ac
--- /dev/null
+++ b/app/src/main/java/com/coderstory/flyme10/xposedcompat/XC_MethodReplacement.java
@@ -0,0 +1,60 @@
+package com.coderstory.flyme10.xposedcompat;
+
+/**
+ * A special case of {@link XC_MethodHook} which completely replaces the original method.
+ */
+public abstract class XC_MethodReplacement extends XC_MethodHook {
+
+    public XC_MethodReplacement() {
+        super();
+    }
+
+    public XC_MethodReplacement(int priority) {
+        super(priority);
+    }
+
+    @Override
+    protected final void beforeHookedMethod(MethodHookParam param) throws Throwable {
+        try {
+            Object result = replaceHookedMethod(param);
+            param.setResult(result);
+        } catch (Throwable t) {
+            param.setThrowable(t);
+        }
+    }
+
+    @Override
+    protected final void afterHookedMethod(MethodHookParam param) throws Throwable {
+    }
+
+    /**
+     * Shortcut for replacing a method completely. Whatever is returned/thrown here is taken
+     * instead of the result of the original method (which will not be called).
+     *
+     * @param param Information about the method call.
+     * @throws Throwable Anything that is thrown by the callback will be passed on to the original caller.
+     */
+    @SuppressWarnings("unused")
+    protected abstract Object replaceHookedMethod(MethodHookParam param) throws Throwable;
+
+    /**
+     * Creates a callback which always returns a specific value.
+     *
+     * @param result The value that should be returned to callers of the hooked method.
+     */
+    public static XC_MethodReplacement returnConstant(final Object result) {
+        return returnConstant(50, result);
+    }
+
+    /**
+     * Like {@link #returnConstant(Object)}, but allows to specify a priority for the callback.
+     */
+    public static XC_MethodReplacement returnConstant(int priority, final Object result) {
+        return new XC_MethodReplacement(priority) {
+            @Override
+            protected Object replaceHookedMethod(MethodHookParam param) throws Throwable {
+                return result;
+            }
+        };
+    }
+}
diff --git a/app/src/main/java/com/coderstory/flyme10/xposedcompat/XResCompat.java b/app/src/main/java/com/coderstory/flyme10/xposedcompat/XResCompat.java
new file mode 100644
index 0000000..92df3de
--- /dev/null
+++ b/app/src/main/java/com/coderstory/flyme10/xposedcompat/XResCompat.java
@@ -0,0 +1,62 @@
+package com.coderstory.flyme10.xposedcompat;
+
+/**
+ * Facade exposing the legacy XResources.setReplacement signatures. Registered replacements
+ * are deferred until the app's Resources object is available (see {@link ResourceCompat}).
+ */
+public final class XResCompat {
+
+    private final String targetPackage;
+
+    XResCompat(String targetPackage) {
+        this.targetPackage = targetPackage;
+    }
+
+    public String getPackageName() {
+        return targetPackage;
+    }
+
+    /**
+     * Replaces the resource with the given numeric id. The id follows the same convention
+     * as the legacy API (i.e. a raw resource id as used by the original code).
+     */
+    public void setReplacement(int id, Object replacement) {
+        ResourceCompat.addIntReplacement(targetPackage, id, replacement);
+    }
+
+    /**
+     * Replaces the resource with the given fully qualified name.
+     */
+    @SuppressWarnings("unused")
+    public void setReplacement(String fullName, Object replacement) {
+        int sep = fullName.lastIndexOf(':');
+        String pkg = sep > 0 ? fullName.substring(0, sep) : targetPackage;
+        String typeAndName = sep > 0 ? fullName.substring(sep + 1) : fullName;
+        int slash = typeAndName.indexOf('/');
+        if (slash <= 0) {
+            throw new IllegalArgumentException("fullName must be of the form package:type/name");
+        }
+        addNameReplacement(pkg, typeAndName.substring(0, slash), typeAndName.substring(slash + 1), replacement);
+    }
+
+    /**
+     * Replaces the resource with the given name (as seen by the module author).
+     */
+    public void setReplacement(String pkg, String type, String name, Object replacement) {
+        addNameReplacement(pkg, type, name, replacement);
+    }
+
+    /**
+     * Replaces the resource with the given name, but only while the boolean
+     * preference {@code gateKey} is enabled. The gate is evaluated whenever the
+     * host queries the resource (emulation layer), so toggling the setting in the
+     * module app takes effect without restarting the host app.
+     */
+    public void setReplacement(String pkg, String type, String name, Object replacement, String gateKey) {
+        ResourceCompat.addNameReplacement(targetPackage, pkg, type, name, replacement, gateKey);
+    }
+
+    private void addNameReplacement(String pkg, String type, String name, Object replacement) {
+        ResourceCompat.addNameReplacement(targetPackage, pkg, type, name, replacement);
+    }
+}
diff --git a/app/src/main/java/com/coderstory/flyme10/xposedcompat/XSharedPreferences.java b/app/src/main/java/com/coderstory/flyme10/xposedcompat/XSharedPreferences.java
new file mode 100644
index 0000000..088e4e5
--- /dev/null
+++ b/app/src/main/java/com/coderstory/flyme10/xposedcompat/XSharedPreferences.java
@@ -0,0 +1,326 @@
+package com.coderstory.flyme10.xposedcompat;
+
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.SystemClock;
+import android.util.Xml;
+
+import org.xmlpull.v1.XmlPullParser;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+
+import io.github.libxposed.api.XposedInterface;
+
+/**
+ * Legacy-shaped read-only preferences.
+ *
+ * <p>Primary source on modern frameworks (API 101+): the framework's remote
+ * preferences service ({@link XposedInterface#getRemotePreferences}), which
+ * serves the module app's {@code shared_prefs/<name>.xml} to hooked processes
+ * through the framework's privileged daemon. Reading the file directly from a
+ * hooked process is impossible there: the file is {@code 0600} and owned by the
+ * module's uid (the legacy frameworks used to relax permissions; modern ones
+ * do not).</p>
+ *
+ * <p>Fallback (no framework attached, embedded framework, or service failure
+ * on a call): parse the module app's {@code shared_prefs/<name>.xml} file
+ * directly, exactly like the legacy XSharedPreferences did.</p>
+ */
+public final class XSharedPreferences {
+
+    private static final String MODULE_PACKAGE = "com.coderstory.flyme10";
+
+    private final String packageName;
+    private final String prefFileName;   // display name, always with .xml
+    private final String groupName;      // remote preferences group (no .xml)
+    private final File[] candidates;
+    private Map<String, Object> values = Collections.emptyMap();
+    private long lastModified = 0L;
+
+    private android.content.SharedPreferences remote;
+    private boolean remoteChecked = false;
+
+    /**
+     * Process-wide cache of values fetched through the module app's exported
+     * PreferencesProvider (content://...PreferencesProvider, call method "getAll").
+     * This channel always reflects the app's current file, independent of any
+     * framework preference sync. Bounded by a short TTL to keep IPC cheap.
+     */
+    private static final long PROVIDER_TTL_MS = 1000L;
+    private static final Object PROVIDER_LOCK = new Object();
+    private static volatile Map<String, Object> providerCache;
+    private static volatile long providerCacheAt = Long.MIN_VALUE;
+
+    private static Map<String, Object> providerGetAll(String groupName) {
+        synchronized (PROVIDER_LOCK) {
+            long now = SystemClock.elapsedRealtime();
+            Map<String, Object> cached = providerCache;
+            if (cached != null && now - providerCacheAt < PROVIDER_TTL_MS) {
+                return cached;
+            }
+            Map<String, Object> fresh = null;
+            try {
+                android.content.Context ctx = AndroidAppHelper.anyContext();
+                if (ctx != null) {
+                    Uri uri = Uri.parse("content://" + MODULE_PACKAGE + ".PreferencesProvider");
+                    Bundle b = ctx.getContentResolver().call(uri, "getAll", groupName, null);
+                    if (b != null) {
+                        fresh = new HashMap<>();
+                        for (String k : b.keySet()) {
+                            fresh.put(k, b.get(k));
+                        }
+                    }
+                }
+            } catch (Throwable ignored) {
+                fresh = null; // provider not available (early boot / not installed / denied)
+            }
+            if (fresh != null) {
+                providerCache = fresh;
+                providerCacheAt = now;
+                return fresh;
+            }
+            return cached; // stale values are better than none
+        }
+    }
+
+    public XSharedPreferences(String packageName, String prefFileName) {
+        this(packageName, prefFileName,
+                new File("/data/data/" + packageName + "/shared_prefs/" + prefFileName + ".xml"));
+    }
+
+    public XSharedPreferences(String prefFileName) {
+        this(MODULE_PACKAGE, prefFileName);
+    }
+
+    public XSharedPreferences(File file) {
+        this(MODULE_PACKAGE, stripXml(file.getName()), file);
+    }
+
+    private XSharedPreferences(String packageName, String prefFileName, File file) {
+        this.packageName = packageName;
+        this.prefFileName = prefFileName.endsWith(".xml") ? prefFileName : prefFileName + ".xml";
+        this.groupName = stripXml(prefFileName);
+        this.candidates = candidatePaths(file);
+    }
+
+    private static String stripXml(String name) {
+        return name.endsWith(".xml") ? name.substring(0, name.length() - 4) : name;
+    }
+
+    /** Tries to obtain the framework-served remote preferences once. */
+    private synchronized void ensureRemote() {
+        if (remoteChecked) {
+            return;
+        }
+        remoteChecked = true;
+        try {
+            XposedInterface x = XposedApi.api;
+            if (x != null) {
+                remote = x.getRemotePreferences(groupName);
+            }
+        } catch (Throwable t) {
+            // Embedded framework or preferences service unavailable: fall back to the file.
+            remote = null;
+        }
+    }
+
+    /** Whether the framework's remote preferences service is in use. */
+    public boolean isRemote() {
+        ensureRemote();
+        return remote != null;
+    }
+
+    private static File[] candidatePaths(File file) {
+        String path = file.getPath();
+        if (path.startsWith("/data/data/")) {
+            String rest = path.substring("/data/data/".length());
+            return new File[]{
+                    file,
+                    new File("/data/user/0/" + rest),
+                    new File("/data/user_de/0/" + rest),
+            };
+        }
+        if (path.startsWith("/data/user/0/")) {
+            String rest = path.substring("/data/user/0/".length());
+            return new File[]{
+                    file,
+                    new File("/data/data/" + rest),
+                    new File("/data/user_de/0/" + rest),
+            };
+        }
+        if (path.startsWith("/data/user_de/0/")) {
+            String rest = path.substring("/data/user_de/0/".length());
+            return new File[]{
+                    file,
+                    new File("/data/data/" + rest),
+                    new File("/data/user/0/" + rest),
+            };
+        }
+        return new File[]{file};
+    }
+
+    private File currentFile() {
+        for (File f : candidates) {
+            if (f.exists() && f.canRead()) {
+                return f;
+            }
+        }
+        return null;
+    }
+
+    /** Reloads the file if it has changed since the last read. */
+    public synchronized void reload() {
+        File f = currentFile();
+        if (f == null) {
+            values = Collections.emptyMap();
+            return;
+        }
+        long mtime = f.lastModified();
+        if (mtime == lastModified && !values.isEmpty()) {
+            return;
+        }
+        Map<String, Object> parsed = parse(f);
+        if (parsed != null) {
+            values = parsed;
+            lastModified = mtime;
+        }
+    }
+
+    private static Map<String, Object> parse(File file) {
+        Map<String, Object> out = new HashMap<>();
+        XmlPullParser parser = Xml.newPullParser();
+        try (FileInputStream is = new FileInputStream(file)) {
+            parser.setFeature(XmlPullParser.FEATURE_PROCESS_NAMESPACES, false);
+            parser.setInput(is, null);
+            int event = parser.getEventType();
+            while (event != XmlPullParser.END_DOCUMENT) {
+                if (event == XmlPullParser.START_TAG) {
+                    String tag = parser.getName();
+                    if ("boolean".equals(tag)) {
+                        out.put(parser.getAttributeValue(null, "name"),
+                                Boolean.parseBoolean(parser.getAttributeValue(null, "value")));
+                    } else if ("string".equals(tag)) {
+                        String name = parser.getAttributeValue(null, "name");
+                        // text may arrive in multiple chunks
+                        StringBuilder sb = new StringBuilder();
+                        int next = parser.next();
+                        while (next == XmlPullParser.TEXT) {
+                            sb.append(parser.getText());
+                            next = parser.next();
+                        }
+                        out.put(name, sb.toString());
+                        continue;
+                    } else if ("int".equals(tag)) {
+                        out.put(parser.getAttributeValue(null, "name"),
+                                Integer.parseInt(parser.getAttributeValue(null, "value")));
+                    } else if ("long".equals(tag)) {
+                        out.put(parser.getAttributeValue(null, "name"),
+                                Long.parseLong(parser.getAttributeValue(null, "value")));
+                    } else if ("float".equals(tag)) {
+                        out.put(parser.getAttributeValue(null, "name"),
+                                Float.parseFloat(parser.getAttributeValue(null, "value")));
+                    } else if ("set".equals(tag)) {
+                        String name = parser.getAttributeValue(null, "name");
+                        Set<String> set = new HashSet<>();
+                        int depth = parser.getDepth();
+                        // consume nested <string> entries
+                        while (!(parser.next() == XmlPullParser.END_TAG
+                                && "set".equals(parser.getName()) && parser.getDepth() == depth)) {
+                            if (parser.getEventType() == XmlPullParser.START_TAG
+                                    && "string".equals(parser.getName())) {
+                                set.add(parser.nextText());
+                            }
+                        }
+                        out.put(name, set);
+                    }
+                }
+                event = parser.next();
+            }
+            return out;
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    public Map<String, Object> getAll() {
+        ensureRemote();
+        Map<String, Object> out = null;
+        if (remote != null) {
+            try {
+                out = new HashMap<>();
+                for (Map.Entry<String, ?> e : remote.getAll().entrySet()) {
+                    out.put(e.getKey(), e.getValue());
+                }
+                // The remote service can return an empty snapshot right after process
+                // start (or before the app side has ever written anything). Only trust it
+                // when non-empty, otherwise fall back to the provider/file below.
+                if (!out.isEmpty()) {
+                    return out;
+                }
+            } catch (Throwable ignored) {
+                out = null;
+                // fall back to the provider / file for this call
+            }
+        }
+        Map<String, Object> fromProvider = providerGetAll(groupName);
+        if (fromProvider != null && !fromProvider.isEmpty()) {
+            return new HashMap<>(fromProvider);
+        }
+        reload();
+        if (!values.isEmpty()) {
+            return new HashMap<>(values);
+        }
+        return out != null ? out : new HashMap<String, Object>();
+    }
+
+    public boolean getBoolean(String key, boolean defValue) {
+        Object v = getAll().get(key);
+        return v instanceof Boolean ? (Boolean) v : defValue;
+    }
+
+    public String getString(String key, String defValue) {
+        Object v = getAll().get(key);
+        return v instanceof String ? (String) v : defValue;
+    }
+
+    @SuppressWarnings("unused")
+    public int getInt(String key, int defValue) {
+        Object v = getAll().get(key);
+        return v instanceof Integer ? (Integer) v : defValue;
+    }
+
+    @SuppressWarnings("unused")
+    public long getLong(String key, long defValue) {
+        Object v = getAll().get(key);
+        return v instanceof Long ? (Long) v : defValue;
+    }
+
+    @SuppressWarnings("unused")
+    public Set<String> getStringSet(String key, Set<String> defValue) {
+        Object v = getAll().get(key);
+        //noinspection unchecked
+        return v instanceof Set ? (Set<String>) v : defValue;
+    }
+
+    @SuppressWarnings("unused")
+    public String getFile() {
+        File f = currentFile();
+        return f == null ? candidates[0].getPath() : f.getPath();
+    }
+
+    @SuppressWarnings("unused")
+    public String getPrefFileName() {
+        return prefFileName;
+    }
+
+    @SuppressWarnings("unused")
+    public String getPackageName() {
+        return packageName;
+    }
+}
